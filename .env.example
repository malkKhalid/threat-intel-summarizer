# ============================================================================
# Threat Intel Summarizer - environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================================

# --- LLM provider: "extractive" (no deps) or "huggingface" (local models) ---
LLM_PROVIDER=extractive

# Hugging Face models (only used when LLM_PROVIDER=huggingface)
HF_SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
HF_CLASSIFIER_MODEL=facebook/bart-large-mnli
HF_CACHE_DIR=./hf_cache

# Comma separated zero-shot trend labels used by the classifier
TREND_LABELS=zero-day exploit,ransomware,data breach,phishing,malware,denial of service,supply chain attack,vulnerability,APT campaign

# --- Storage ---
DATABASE_PATH=./data/threatintel.db
REPORT_OUTPUT_DIR=./data/reports

# --- Feed / pipeline knobs ---
MAX_ARTICLES_PER_FEED=10
FRESHNESS_HOURS=24
URGENCY_ALERT_THRESHOLD=70

# --- Email (SMTP) alerts ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=you@example.com
SMTP_TO=analyst@example.com
SMTP_USE_TLS=true

# --- Slack alerts ---
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Twilio SMS (optional) ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# --- Flask dashboard ---
FLASK_SECRET_KEY=change-me
